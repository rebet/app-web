{
    "name": "rebet/app-web",
    "description": "WEB application skelton for the Rebet PHP framework",
    "keywords": [
        "rebet",
        "framework"
    ],
    "license": "MIT",
    "type": "project",
    "config": {
        "platform": {
            "php": "8.3"
        },
        "sort-packages": true,
        "vendor-dir": "app/vendor"
    },
    "require": {
        "php": "^8.3",
        "rebet/rebet": "dev-php-8.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/core/modules/App"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/src/App/Tests/"
        }
    },
    "scripts": {
        "rebet": "rebet"
    }
}